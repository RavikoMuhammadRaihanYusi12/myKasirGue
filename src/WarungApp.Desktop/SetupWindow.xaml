<Window x:Class="WarungApp.Desktop.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WarungApp — Setup Akun Pemilik" Height="360" Width="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Buat akun Pemilik" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Username" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtUsername" FontSize="16" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <TextBlock Text="Nama Lengkap" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtNama" FontSize="16" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Password (min. 6 karakter)" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" FontSize="16" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,12">
            <TextBlock Text="Ulangi Password" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword2" FontSize="16" Padding="6"/>
        </StackPanel>

        <StackPanel Grid.Row="5" VerticalAlignment="Bottom">
            <TextBlock x:Name="TxtError" Foreground="DarkRed" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <Button x:Name="BtnSimpan" Content="Simpan &amp; Masuk" Height="40" FontSize="16" Click="BtnSimpan_Click"/>
        </StackPanel>
    </Grid>
</Window>
