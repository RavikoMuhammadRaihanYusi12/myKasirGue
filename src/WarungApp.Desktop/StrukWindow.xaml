<Window x:Class="WarungApp.Desktop.StrukWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transaksi Berhasil" Width="1280" Height="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Transaksi Berhasil" FontSize="36" FontWeight="Bold"
                   Foreground="{StaticResource WarnaUtama}" Margin="0,0,0,24"/>

        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="48,32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="No. Transaksi" FontSize="24" Margin="0,0,0,24"/>
                <TextBlock x:Name="TxtNoTransaksi" Grid.Row="0" Grid.Column="1" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Total" FontSize="24" Margin="0,0,0,24"/>
                <TextBlock x:Name="TxtTotal" Grid.Row="1" Grid.Column="1" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Uang Bayar" FontSize="24" Margin="0,0,0,24"/>
                <TextBlock x:Name="TxtBayar" Grid.Row="2" Grid.Column="1" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Kembalian" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtKembalian" Grid.Row="3" Grid.Column="1" FontSize="40" FontWeight="Bold"
                           Foreground="{StaticResource WarnaUtama}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Button Grid.Row="2" Content="Tutup" Width="240" Height="56" FontSize="20"
                Margin="0,24,0,0" HorizontalAlignment="Right"
                IsDefault="True" IsCancel="True" Click="Tutup_Click"/>
    </Grid>
</Window>
