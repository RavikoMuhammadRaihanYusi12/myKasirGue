<UserControl x:Class="WarungApp.Desktop.Views.BarangView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <TextBox Width="260" Text="{Binding KataCari, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="CariKeyDown" x:Name="TxtCari"/>
                <Button Content="Cari" Margin="8,0,0,0" Command="{Binding CariCommand}"/>
                <ComboBox Width="160" Margin="8,0,0,0" ItemsSource="{Binding KategoriList}"
                          SelectedItem="{Binding KategoriTerpilih}" DisplayMemberPath="Nama"/>
                <CheckBox Content="Stok menipis" Margin="12,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding HanyaMenipis}"/>
                <CheckBox Content="Tampilkan nonaktif" Margin="12,0,0,0" VerticalAlignment="Center"
                          IsChecked="{Binding TampilkanNonaktif}"/>
                <Button Content="Terapkan" Margin="8,0,0,0" Style="{StaticResource TombolSekunder}"
                        Command="{Binding CariCommand}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Daftar}" SelectedItem="{Binding TerpilihBarang}"
                      MouseDoubleClick="GridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kode" Binding="{Binding Kode}" Width="90"/>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding Kategori}" Width="120"/>
                    <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="70"/>
                    <DataGridTextColumn Header="Harga Beli" Binding="{Binding HargaBeli, Converter={StaticResource Rupiah}}" Width="110"/>
                    <DataGridTextColumn Header="Harga Jual" Binding="{Binding HargaJual, Converter={StaticResource Rupiah}}" Width="110"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="60"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding StokMinimum}" Width="55"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Aktif, Converter={StaticResource AktifText}}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding JudulForm}" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

                    <TextBlock Text="Kode / Barcode (opsional)"/>
                    <TextBox Text="{Binding FormKode, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                    <TextBlock Text="Nama Barang *"/>
                    <TextBox Text="{Binding FormNama, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                    <TextBlock Text="Kategori *"/>
                    <ComboBox ItemsSource="{Binding KategoriList}" SelectedItem="{Binding FormKategori}"
                              DisplayMemberPath="Nama" Margin="0,4,0,10"/>

                    <TextBlock Text="Satuan"/>
                    <TextBox Text="{Binding FormSatuan, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                    <TextBlock Text="Harga Beli (Rp)"/>
                    <TextBox Text="{Binding FormHargaBeli, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                    <TextBlock Text="Harga Jual (Rp)"/>
                    <TextBox Text="{Binding FormHargaJual, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                    <TextBlock Text="Stok Minimum"/>
                    <TextBox Text="{Binding FormStokMinimum, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>

                    <CheckBox Content="Aktif" IsChecked="{Binding FormAktif}" Margin="0,0,0,12"/>

                    <TextBlock Text="{Binding Pesan}" TextWrapping="Wrap" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarnaUtama}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PesanError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnaBahaya}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Simpan" Command="{Binding SimpanCommand}"/>
                        <Button Grid.Column="2" Content="Barang Baru" Style="{StaticResource TombolSekunder}"
                                Command="{Binding BaruCommand}"/>
                    </Grid>

                    <Button Content="Nonaktifkan" Margin="0,8,0,0" Background="{StaticResource WarnaBahaya}"
                            Command="{Binding NonaktifkanCommand}"
                            Visibility="{Binding BisiNonaktifkan, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Aktifkan" Margin="0,8,0,0"
                            Command="{Binding AktifkanCommand}"
                            Visibility="{Binding BisiAktifkan, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
