<UserControl x:Class="WarungApp.Desktop.Views.PengaturanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="White" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Data Toko" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Nama toko"/>
                        <TextBox Text="{Binding NamaToko, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <TextBlock Text="Alamat"/>
                        <TextBox Text="{Binding Alamat, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                        <TextBlock Text="Nomor telepon"/>
                        <TextBox Text="{Binding Telepon, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Aturan Penjualan" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <CheckBox Content="Boleh menjual saat stok kosong (stok minus)"
                                  IsChecked="{Binding BolehStokMinus}"/>
                    </StackPanel>
                </Border>

                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Backup" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <TextBlock Text="Folder backup"/>
                        <Grid Margin="0,4,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding FolderBackup, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="Pilih..." Margin="8,0,0,0" Style="{StaticResource TombolSekunder}"
                                    Command="{Binding PilihFolderCommand}"/>
                        </Grid>
                        <TextBlock Text="Jumlah backup disimpan"/>
                        <TextBox Text="{Binding RetensiBackup, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,4,0,10"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding Pesan}" TextWrapping="Wrap" Margin="0,12,0,8" Foreground="{StaticResource WarnaUtama}"/>
                <Button Content="Simpan Pengaturan" Height="40" Command="{Binding SimpanCommand}"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Berkas Backup" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock DockPanel.Dock="Top" Text="{Binding FolderAktif}" Foreground="#6B7D73" TextWrapping="Wrap" Margin="0,0,0,10"/>

                <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding PesanBackup}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Backup Sekarang" Command="{Binding BackupSekarangCommand}"/>
                        <Button Grid.Column="2" Content="Restore yang Dipilih" Background="{StaticResource WarnaBahaya}"
                                Command="{Binding RestoreCommand}" CommandParameter="{Binding SelectedItem, ElementName=GridBackup}"/>
                    </Grid>
                </Grid>

                <ListBox x:Name="GridBackup" ItemsSource="{Binding DaftarBackup}"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
