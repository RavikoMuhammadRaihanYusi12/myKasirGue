<UserControl x:Class="WarungApp.Desktop.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Dari tanggal"/>
                <DatePicker SelectedDate="{Binding Dari}" Width="140"/>
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
                <TextBlock Text="Sampai tanggal"/>
                <DatePicker SelectedDate="{Binding Sampai}" Width="140"/>
            </StackPanel>
            <Button Content="Muat" VerticalAlignment="Bottom" Command="{Binding MuatCommand}"/>
            <TextBlock Text="{Binding Pesan}" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource WarnaBahaya}"/>
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Daftar}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu, StringFormat={}{0:dd/MM/yyyy HH:mm:ss}}" Width="160"/>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="140"/>
                <DataGridTextColumn Header="Aksi" Binding="{Binding Aksi}" Width="180"/>
                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
