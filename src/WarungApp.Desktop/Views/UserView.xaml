<UserControl x:Class="WarungApp.Desktop.Views.UserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0" Margin="0,0,16,0" ItemsSource="{Binding Daftar}" SelectedItem="{Binding Terpilih}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="140"/>
                <DataGridTextColumn Header="Nama" Binding="{Binding NamaLengkap}" Width="*"/>
                <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="90"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Aktif, Converter={StaticResource AktifText}}" Width="90"/>
                <DataGridTextColumn Header="Dibuat" Binding="{Binding DibuatPada, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="16">
            <StackPanel>
                <TextBlock Text="Akun Pengguna" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                <TextBlock Text="Username"/>
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                <TextBlock Text="Nama lengkap"/>
                <TextBox Text="{Binding NamaLengkap, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,10"/>
                <TextBlock Text="Password (baru / reset)"/>
                <PasswordBox x:Name="TxtPassword" PasswordChanged="PasswordChanged" Margin="0,4,0,10"/>
                <TextBlock Text="{Binding Pesan}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Button Content="Tambah Kasir" Command="{Binding TambahCommand}" Margin="0,0,0,8"/>
                <Button Content="Reset Password" Style="{StaticResource TombolSekunder}" Command="{Binding ResetPasswordCommand}" Margin="0,0,0,8"/>
                <Button Content="Nonaktifkan Akun" Background="{StaticResource WarnaBahaya}" Command="{Binding NonaktifkanCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
