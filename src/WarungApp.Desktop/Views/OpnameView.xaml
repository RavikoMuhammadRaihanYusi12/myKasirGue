<UserControl x:Class="WarungApp.Desktop.Views.OpnameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
            <TextBlock DockPanel.Dock="Top" Text="Cari barang" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="230" Text="{Binding KataCari, UpdateSourceTrigger=PropertyChanged}" KeyDown="CariKeyDown"/>
                <Button Content="Cari" Margin="8,0,0,0" Command="{Binding CariBarangCommand}"/>
            </StackPanel>
            <Button DockPanel.Dock="Bottom" Content="Tambah untuk Opname" Margin="0,8,0,0"
                    Command="{Binding TambahBarisCommand}"/>
            <DataGrid ItemsSource="{Binding HasilCari}" SelectedItem="{Binding HasilTerpilih}" MouseDoubleClick="HasilDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Bottom">
                <TextBlock Text="{Binding Pesan}" TextWrapping="Wrap" Margin="0,6,0,6">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource WarnaUtama}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PesanError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarnaBahaya}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Content="Simpan Opname" Height="40" Command="{Binding SimpanCommand}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding Baris}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Barang" Binding="{Binding Nama}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="70" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stok Sistem" Binding="{Binding StokSistem}" Width="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Stok Fisik" Binding="{Binding StokFisik, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
                    <DataGridTextColumn Header="Selisih" Binding="{Binding Selisih}" Width="80" IsReadOnly="True"/>
                    <DataGridComboBoxColumn Header="Alasan" Width="140"
                        SelectedItemBinding="{Binding Alasan, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{Binding DataContext.AlasanPilihan, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Hapus" Padding="6,2" Background="{StaticResource WarnaBahaya}"
                                        Command="{Binding DataContext.HapusBarisCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2">
            <TextBlock DockPanel.Dock="Top" Text="Riwayat penyesuaian stok" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid ItemsSource="{Binding Riwayat}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                    <DataGridTextColumn Header="Barang" Binding="{Binding Barang}" Width="*"/>
                    <DataGridTextColumn Header="Sistem" Binding="{Binding StokSistem}" Width="80"/>
                    <DataGridTextColumn Header="Fisik" Binding="{Binding StokFisik}" Width="80"/>
                    <DataGridTextColumn Header="Selisih" Binding="{Binding Selisih}" Width="80"/>
                    <DataGridTextColumn Header="Alasan" Binding="{Binding Alasan}" Width="140"/>
                    <DataGridTextColumn Header="Oleh" Binding="{Binding User}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
