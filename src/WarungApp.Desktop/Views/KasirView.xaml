<UserControl x:Class="WarungApp.Desktop.Views.KasirView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="420"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,16,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Cari Barang" FontSize="12" Foreground="#6B7280"/>
                    <TextBox x:Name="TxtCari" Width="320" FontSize="18" Padding="10"
                             Text="{Binding KataCari, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="CariKeyDown"
                             TextChanged="CariTextChanged"/>
                </StackPanel>
                <StackPanel Margin="0,0,8,0" VerticalAlignment="Bottom">
                    <TextBlock Text="Qty" FontSize="12" Foreground="#6B7280"/>
                    <TextBox Text="{Binding InputQty, UpdateSourceTrigger=PropertyChanged}" FontSize="18" Padding="10" Width="80"/>
                </StackPanel>
                <Button Content="Cari" Margin="8,0,0,0" VerticalAlignment="Bottom" Padding="16,10"
                        Command="{Binding CariCommand}"/>
                <Button Content="Tambah ke Keranjang" Margin="8,0,0,0" VerticalAlignment="Bottom" Padding="16,10"
                        Command="{Binding TambahKeKeranjangCommand}"/>
            </StackPanel>

            <TextBlock DockPanel.Dock="Top" Text="Pilih barang lalu isi Qty dan klik 'Tambah ke Keranjang'. F2=Bayar, Esc=Bersihkan."
                       Foreground="#6B7D73" Margin="0,0,0,8"/>

            <DataGrid ItemsSource="{Binding HasilCari}" SelectedItem="{Binding HasilTerpilih}"
                      MouseDoubleClick="HasilDoubleClick" KeyDown="HasilKeyDown" RowHeight="36">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="80"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="70"/>
                    <DataGridTextColumn Header="Harga" Binding="{Binding HargaJual, Converter={StaticResource Rupiah}}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DataGrid Grid.Row="0" ItemsSource="{Binding Keranjang}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" IsReadOnly="True"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, Converter={StaticResource Rupiah}}" Width="100" IsReadOnly="True"/>
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="X" Padding="6,2" Background="{StaticResource WarnaBahaya}"
                                        Command="{Binding DataContext.HapusItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Total" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding TotalTampil}" FontSize="28" FontWeight="Bold"/>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Uang Bayar"/>
                            <TextBox Text="{Binding UangBayar, UpdateSourceTrigger=PropertyChanged}" FontSize="18"
                                     Padding="8" KeyDown="BayarKeyDown"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Uang Pas" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                Style="{StaticResource TombolSekunder}" Command="{Binding UangPasCommand}"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Kembalian" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding KembalianTampil}" FontSize="22" FontWeight="SemiBold"/>
                    </Grid>

                    <TextBlock Text="{Binding Pesan}" TextWrapping="Wrap" Margin="0,10,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource WarnaUtama}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PesanError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource WarnaBahaya}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="Bayar (F2)" Height="48" FontSize="18"
                                Command="{Binding BayarCommand}"/>
                        <Button Grid.Column="2" Content="Reset" Style="{StaticResource TombolSekunder}"
                                Command="{Binding KosongkanCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
