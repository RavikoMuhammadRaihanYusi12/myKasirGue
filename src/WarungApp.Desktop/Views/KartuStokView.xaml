<UserControl x:Class="WarungApp.Desktop.Views.KartuStokView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBox Width="230" Text="{Binding KataCari, UpdateSourceTrigger=PropertyChanged}" KeyDown="CariKeyDown"/>
                <Button Content="Cari" Margin="8,0,0,0" Command="{Binding CariCommand}"/>
            </StackPanel>
            <DataGrid ItemsSource="{Binding HasilCari}" SelectedItem="{Binding HasilTerpilih}"
                      MouseDoubleClick="GridDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                    <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="60"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <DockPanel Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding Judul}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DataGrid ItemsSource="{Binding Mutasi}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu, StringFormat={}{0:dd/MM/yyyy HH:mm}}" Width="140"/>
                    <DataGridTextColumn Header="Jenis" Binding="{Binding Jenis}" Width="110"/>
                    <DataGridTextColumn Header="Qty" Binding="{Binding Qty}" Width="70"/>
                    <DataGridTextColumn Header="Sebelum" Binding="{Binding StokSebelum}" Width="80"/>
                    <DataGridTextColumn Header="Sesudah" Binding="{Binding StokSesudah}" Width="80"/>
                    <DataGridTextColumn Header="Oleh" Binding="{Binding User}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
