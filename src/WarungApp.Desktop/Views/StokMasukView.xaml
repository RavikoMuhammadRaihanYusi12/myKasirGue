<UserControl x:Class="WarungApp.Desktop.Views.StokMasukView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Tanggal"/>
                <DatePicker SelectedDate="{Binding Tanggal}" Width="140"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                <TextBlock Text="Supplier"/>
                <TextBox Text="{Binding Supplier, UpdateSourceTrigger=PropertyChanged}" Width="200"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="0,0,12,0">
                <TextBlock Text="Catatan"/>
                <TextBox Text="{Binding Catatan, UpdateSourceTrigger=PropertyChanged}" Width="240"/>
            </StackPanel>
            <CheckBox Grid.Column="3" Content="Perbarui harga beli" VerticalAlignment="Bottom" Margin="0,0,12,8"
                      IsChecked="{Binding UpdateHargaBeli}"/>
            <TextBlock Grid.Column="4" Text="{Binding Pesan}" VerticalAlignment="Center" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource WarnaUtama}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PesanError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarnaBahaya}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBox Width="230" Text="{Binding KataCari, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="CariKeyDown"/>
                    <Button Content="Cari" Margin="8,0,0,0" Command="{Binding CariBarangCommand}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Qty" FontSize="12" Foreground="#6B7280"/>
                        <TextBox Text="{Binding InputQty, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                    </StackPanel>
                    <Button Content="Tambah ke Keranjang"
                            Command="{Binding TambahItemCommand}"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding HasilCari}" SelectedItem="{Binding HasilTerpilih}"
                          MouseDoubleClick="HasilDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
                        <DataGridTextColumn Header="Stok" Binding="{Binding Stok}" Width="55"/>
                        <DataGridTextColumn Header="H.Beli" Binding="{Binding HargaBeli, Converter={StaticResource Rupiah}}" Width="85"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>

            <DockPanel Grid.Column="1">
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Total kulakan:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding TotalTampil}" FontSize="20" FontWeight="Bold"/>
                </Grid>
                <Button DockPanel.Dock="Bottom" Content="Simpan Stok Masuk" Height="40" Margin="0,8,0,0"
                        Command="{Binding SimpanCommand}"/>
                <DataGrid ItemsSource="{Binding Keranjang}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Satuan" Binding="{Binding Satuan}" Width="70" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Qty, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Harga Beli" Binding="{Binding HargaBeli, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                        <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, Converter={StaticResource Rupiah}}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Hapus" Padding="6,2" Background="{StaticResource WarnaBahaya}"
                                            Command="{Binding DataContext.HapusItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <DockPanel Grid.Row="2">
            <TextBlock DockPanel.Dock="Top" Text="Riwayat stok masuk" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DataGrid ItemsSource="{Binding Riwayat}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tanggal" Binding="{Binding Tanggal, StringFormat={}{0:dd/MM/yyyy}}" Width="100"/>
                    <DataGridTextColumn Header="Supplier" Binding="{Binding Supplier}" Width="160"/>
                    <DataGridTextColumn Header="Catatan" Binding="{Binding Catatan}" Width="*"/>
                    <DataGridTextColumn Header="Oleh" Binding="{Binding User}" Width="120"/>
                    <DataGridTextColumn Header="Total" Binding="{Binding Total, Converter={StaticResource Rupiah}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
